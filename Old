function downloadExcel() {
    if (!selectedClient) return;
    let worksheetRows = generateExcelData();
    const ws = XLSX.utils.json_to_sheet(worksheetRows);
    const wb = XLSX.utils.book_new();
    XLSX.utils.book_append_sheet(wb, ws, "Inventory Report");
    XLSX.writeFile(wb, `${selectedClient}.xlsx`);
}

function copyToClipboard() {
    if (!selectedClient) return;
    let filteredItems = getFilteredItems();
    if (filteredItems.length === 0) return alert("Δεν υπάρχουν είδη στη λίστα για αντιγραφή.");
    
    let textResult = "";
    filteredItems.forEach(item => {
        let p = item.price !== undefined ? Number(item.price).toFixed(2) : '0.00';
        textResult += `${item.code}\t\t${item.lotNumber || ''}\t${item.quantity}\t${item.weight}\t${item.tare}\t${item.newWeight}\t${p}\n`;
    });
    
    navigator.clipboard.writeText(textResult).then(() => {
        const copyBtn = document.getElementById('copyClipboardBtn');
        const originalText = copyBtn.textContent;
        copyBtn.textContent = "✅ Αντιγράφηκε με επιτυχία!";
        copyBtn.style.background = "var(--green)";
        setTimeout(() => {
            copyBtn.textContent = originalText;
            copyBtn.style.background = "var(--teal)";
            closeExportModal();
        }, 1200);
    });
}

async function sendBrevoEmail() {
    const apiKey = CONFIG.brevoApiKey.trim();
    const recipient = CONFIG.recipientEmail.trim();
    const btn = document.getElementById('emailSendBtn');
    
    btn.textContent = "Δημιουργία & Αποστολή...";
    btn.disabled = true;

    let clientId = data[selectedClient].id || '00000';
    const today = new Date();
    const formattedDate = `${String(today.getDate()).padStart(2, '0')}/${String(today.getMonth() + 1).padStart(2, '0')}/${today.getFullYear()}`;

    let worksheetRows = generateExcelData();
    const ws = XLSX.utils.json_to_sheet(worksheetRows);
    const wb = XLSX.utils.book_new();
    XLSX.utils.book_append_sheet(wb, ws, "Inventory Report");
    const wbout = XLSX.write(wb, { bookType: 'xlsx', type: 'base64' });

    const payload = {
        sender: { name: "Weight Manager App", email: "kookydynamo@gmail.com" },
        to: [{ email: recipient }],
        subject: `${selectedClient} | ${clientId} | ${formattedDate}`,
        htmlContent: `<p>Παρακαλώ βρείτε συνημμένο ζυγολόγιο σε αρχείο Excel</p>`,
        attachment: [{ content: wbout, name: `${selectedClient}.xlsx` }]
    };

    try {
        const response = await fetch('https://api.brevo.com/v3/smtp/email', {
            method: 'POST',
            headers: { 'accept': 'application/json', 'api-key': apiKey, 'content-type': 'application/json' },
            body: JSON.stringify(payload)
        });
        if (response.ok) { 
            alert(`Το email στάλθηκε με επιτυχία στο ${recipient}!`); 
            closeExportModal(); 
        } else {
            const errorData = await response.json();
            alert("Σφάλμα Brevo: " + (errorData.message || response.statusText));
        }
    } catch (error) { 
        alert("Προέκυψε σφάλμα (Failed to fetch).\n\nΑν έχετε Ad-Blocker ή χρησιμοποιείτε Brave Browser, απενεργοποιήστε τα προσωρινά για αυτή τη σελίδα."); 
    }
    finally { btn.textContent = "✉ Αποστολή Αναφοράς μέσω Email"; btn.disabled = false; }
}

function openModal(){
    if (!selectedClient) return alert('Επιλέξτε πρώτα έναν πελάτη');
    editingIndex = null;
    document.getElementById('modalTitle').textContent = 'Προσθήκη Είδους';
    document.getElementById('saveBtn').textContent = 'Προσθήκη';
    document.getElementById('modal').style.display = 'flex';
    setTimeout(() => document.getElementById('code').focus(), 100);
}

function closeModal(){
    document.getElementById('modal').style.display = 'none';
    editingIndex = null;
    document.getElementById('code').value = '';
    document.getElementById('quantity').value = '';
    document.getElementById('weight').value = '';
    document.getElementById('tare').value = '';
    document.getElementById('newWeight').value = '';
    document.getElementById('price').value = '';
    document.getElementById('comment').value = '';
}

function editItem(index){
    let itemsArr = Object.values(data[selectedClient].items || {});
    const item = itemsArr[index];
    editingIndex = index;
    document.getElementById('code').value = item.code;
    document.getElementById('quantity').value = item.quantity;
    document.getElementById('weight').value = item.weight;
    document.getElementById('tare').value = item.tare;
    document.getElementById('newWeight').value = item.newWeight;
    document.getElementById('price').value = item.price !== undefined ? item.price : '';
    document.getElementById('comment').value = item.comment !== undefined ? item.comment : '';
    
    document.getElementById('modalTitle').textContent = 'Επεξεργασία Είδους';
    document.getElementById('saveBtn').textContent = 'Αποθήκευση';
    document.getElementById('modal').style.display = 'flex';
    setTimeout(() => document.getElementById('code').focus(), 100);
}

function saveItem(){
    const q = Number(document.getElementById('quantity').value);
    const w = Number(document.getElementById('weight').value);
    const t = Number(document.getElementById('tare').value);
    const p = document.getElementById('price').value !== '' ? Number(document.getElementById('price').value) : 0;
    let transformedCode = convertToGreekUppercase(document.getElementById('code').value.trim());
    let transformedComment = convertToGreekUppercase(document.getElementById('comment').value.trim());

    const item = { 
        code: transformedCode, 
        lotNumber: '', 
        quantity: q, 
        weight: w, 
        tare: t, 
        newWeight: Number((w - (t * q)).toFixed(2)),
        price: p,
        comment: transformedComment
    };

    if (!item.code || isNaN(item.quantity) || isNaN(item.weight) || isNaN(item.tare) || isNaN(item.price)) return alert('Παρακαλώ συμπληρώστε σωστά όλα τα πεδία');

    let itemsArr = [];
    if (data[selectedClient] && data[selectedClient].items) { itemsArr = Object.values(data[selectedClient].items); }

    if (editingIndex !== null) { itemsArr[editingIndex] = item; } else { itemsArr.push(item); }

    set(ref(db, 'clientsData/' + selectedClient + '/items'), itemsArr).then(() => { closeModal(); });
}

function deleteItem(index){
    if (confirm('Διαγραφή είδους;')) {
        let itemsArr = Object.values(data[selectedClient].items || {});
        itemsArr.splice(index, 1);
        set(ref(db, 'clientsData/' + selectedClient + '/items'), itemsArr);
    }
}

